<Window x:Class="BrowserWall.App.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserWall"
        Width="360" Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        Background="#2D2D30">
    <TextBlock x:Name="MessageText"
               Foreground="White"
               FontSize="15"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Focusable="False" />
</Window>
