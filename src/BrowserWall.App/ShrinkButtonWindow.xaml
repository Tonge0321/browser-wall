<Window x:Class="BrowserWall.App.ShrinkButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="120" Height="32"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        Background="#2D2D30">
    <Button x:Name="ShrinkButton"
            FontSize="13"
            Foreground="White"
            Background="#3E6FB0"
            BorderThickness="0"
            Cursor="Hand" />
</Window>
