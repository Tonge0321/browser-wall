<Window x:Class="BrowserWall.App.AddWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Explanation when the cells are full; the dialog stays open -->
        <TextBlock x:Name="ProblemText" Grid.Row="0" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,6" />
        <!-- Windows that can be added; picking a row adds it; refreshed every second while open -->
        <ListBox x:Name="WindowList" Grid.Row="1" DisplayMemberPath="Title"
                 SelectionChanged="OnSelectionChanged" />
        <TextBlock x:Name="EmptyHint" Grid.Row="1" TextWrapping="Wrap" FontSize="14"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   Visibility="Collapsed" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
